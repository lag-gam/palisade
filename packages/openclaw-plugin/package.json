{
  "name": "palisade-openclaw",
  "version": "0.1.0",
  "description": "Palisade runtime guardrails plugin for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "palisade",
    "openclaw",
    "ai-safety",
    "guardrails",
    "runtime-security"
  ],
  "license": "MIT",
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "latest",
    "typescript": "^5.9.0"
  }
}
